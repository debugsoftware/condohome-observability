    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "API viva via OTLP: presença de métricas JVM (service_name=condohome-api). NÃO usa up{job=condohome-api} — scrape Actuator fica 401/down de propósito (CH-43).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "NO DATA" }, "1": { "color": "green", "text": "LIVE" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
