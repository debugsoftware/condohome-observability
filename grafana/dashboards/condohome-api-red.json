          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(condohome_charges_import_parse_errors_total{service_name=\"condohome-api\"}[5m])) by (error_type, source)",
          "legendFormat": "{{error_type}} {{source}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(condohome_charges_import_duration_milliseconds_count{service_name=\"condohome-api\"}) by (source)",
