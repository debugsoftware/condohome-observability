    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "condohome_charges_import_parse_errors_total{error_type,source} — só após 1º parse error. Sem série = ainda sem erro registrado.",
      "fieldConfig": {
