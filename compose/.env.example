# CondoHome Observability — variáveis de exemplo (piloto)
# Copie para .env e ajuste. Nunca commit de senhas reais.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
# Porta no host; compose publica só em 127.0.0.1 (não na internet)
GRAFANA_HOST_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# Opcional: timezone dos containers (box/piloto)
# TZ=America/Sao_Paulo
